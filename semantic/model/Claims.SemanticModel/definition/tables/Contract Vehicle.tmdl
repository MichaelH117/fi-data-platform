table 'Contract Vehicle'

	column 'Contract Key'
		dataType: string
		isHidden
		isKey
		sourceColumn: CONTRACT_KEY

	column 'VIN Hash'
		dataType: string
		sourceColumn: VIN_HASH

	column 'Is Valid VIN'
		dataType: boolean
		sourceColumn: IS_VALID_VIN

	column 'Chassis VIN Hash'
		dataType: string
		sourceColumn: CHASSIS_VIN_HASH

	column 'Has Chassis VIN'
		dataType: boolean
		sourceColumn: HAS_CHASSIS_VIN

	column 'Vehicle Year'
		dataType: int64
		summarizeBy: none
		sourceColumn: VEHICLE_YEAR

	column 'Vehicle Make'
		dataType: string
		sourceColumn: VEHICLE_MAKE

	column 'Vehicle Model'
		dataType: string
		sourceColumn: VEHICLE_MODEL

	column 'Fuel Type'
		dataType: string
		sourceColumn: FUEL_TYPE

	column Cylinders
		dataType: int64
		summarizeBy: none
		sourceColumn: CYLINDERS

	column 'Drive Type'
		dataType: string
		sourceColumn: DRIVE_TYPE

	column 'Is Commercial'
		dataType: boolean
		sourceColumn: IS_COMMERCIAL

	column 'Title Brand'
		dataType: string
		sourceColumn: TITLE_BRAND

	column 'New Used'
		dataType: string
		sourceColumn: NEW_USED

	column Odometer
		dataType: int64
		summarizeBy: none
		sourceColumn: ODOMETER

	column 'Odometer Band'
		dataType: string
		sourceColumn: ODOMETER_BAND

	partition 'Contract Vehicle' = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse, [Role = "REPORTER"]),
				    Db = Source{[Name = AnalyticsDatabase, Kind = "Database"]}[Data],
				    Schema = Db{[Name = "CORE", Kind = "Schema"]}[Data],
				    Data = Schema{[Name = "DIM_CONTRACT_VEHICLE", Kind = "Table"]}[Data]
				in
				    Data

	annotation source_table = core.dim_contract_vehicle
	annotation table_kind = dim
