table Product

	column 'Product Key'
		dataType: string
		isHidden
		isKey
		sourceColumn: PRODUCT_KEY

	column 'Plan ID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: PLAN_ID

	column 'Program ID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: PROGRAM_ID

	column 'Product ID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: PRODUCT_ID

	column 'Category Code'
		dataType: string
		sourceColumn: CATEGORY_CODE

	column Category
		dataType: string
		sourceColumn: CATEGORY

	column 'Subcategory Code'
		dataType: string
		sourceColumn: SUBCATEGORY_CODE

	column Subcategory
		dataType: string
		sourceColumn: SUBCATEGORY

	column 'Product Code'
		dataType: string
		sourceColumn: PRODUCT_CODE

	column Product
		dataType: string
		sourceColumn: PRODUCT

	column 'Plan Code'
		dataType: string
		sourceColumn: PLAN_CODE

	column Plan
		dataType: string
		sourceColumn: PLAN

	column 'Program Code'
		dataType: string
		sourceColumn: PROGRAM_CODE

	column Program
		dataType: string
		sourceColumn: PROGRAM

	column 'Plan Year'
		dataType: int64
		summarizeBy: none
		sourceColumn: PLAN_YEAR

	column 'Model Year'
		dataType: int64
		summarizeBy: none
		sourceColumn: MODEL_YEAR

	column 'Program Suffix'
		dataType: string
		sourceColumn: PROGRAM_SUFFIX

	column 'Is Do Not Use'
		dataType: boolean
		sourceColumn: IS_DO_NOT_USE

	column 'Product Base Name'
		dataType: string
		sourceColumn: PRODUCT_BASE_NAME

	column 'Program Type'
		dataType: string
		sourceColumn: PROGRAM_TYPE

	column 'Compliance Family'
		dataType: string
		sourceColumn: COMPLIANCE_FAMILY

	column 'Short Code'
		dataType: string
		sourceColumn: SHORT_CODE

	column 'Is Cancellable'
		dataType: boolean
		sourceColumn: IS_CANCELLABLE

	column 'Contract Prefix'
		dataType: string
		sourceColumn: CONTRACT_PREFIX

	column 'Deductible Amount'
		dataType: double
		summarizeBy: none
		sourceColumn: DEDUCTIBLE_AMOUNT

	column 'Deductible Name'
		dataType: string
		sourceColumn: DEDUCTIBLE_NAME

	column 'Tier Rank'
		dataType: int64
		summarizeBy: none
		sourceColumn: TIER_RANK

	column 'Is Bundle'
		dataType: boolean
		sourceColumn: IS_BUNDLE

	column 'External Product Line'
		dataType: string
		sourceColumn: EXTERNAL_PRODUCT_LINE

	hierarchy 'Product Hierarchy'

		level Category
			column: Category

		level Subcategory
			column: Subcategory

		level Product
			column: Product

		level Plan
			column: Plan

		level Program
			column: Program

	partition Product = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse, [Role = "REPORTER"]),
				    Db = Source{[Name = AnalyticsDatabase, Kind = "Database"]}[Data],
				    Schema = Db{[Name = "CORE", Kind = "Schema"]}[Data],
				    Data = Schema{[Name = "DIM_PRODUCT", Kind = "Table"]}[Data]
				in
				    Data

	annotation source_table = core.dim_product
	annotation table_kind = dim
