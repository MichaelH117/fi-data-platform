table 'Gross Premium'

	column 'Contract Key'
		dataType: string
		isHidden
		sourceColumn: CONTRACT_KEY

	column 'Posting Period Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: POSTING_PERIOD_KEY

	column 'Posting Period Start Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		sourceColumn: POSTING_PERIOD_START_DATE

	column 'Dealer Key'
		dataType: string
		isHidden
		sourceColumn: DEALER_KEY

	column 'Product Key'
		dataType: string
		isHidden
		sourceColumn: PRODUCT_KEY

	column 'Tenant Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: TENANT_KEY

	column 'Entered Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ENTERED_DATE_KEY

	column 'Posted Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: POSTED_DATE_KEY

	column 'Coverage Cost'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: COVERAGE_COST

	column 'Sale Coverage Cost'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: SALE_COVERAGE_COST

	column 'Amend Coverage Cost'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: AMEND_COVERAGE_COST

	column 'Purchase Price'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: PURCHASE_PRICE

	column 'Retail Price'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: RETAIL_PRICE

	column 'Contracts Written'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CONTRACTS_WRITTEN

	column 'Refund Pct'
		dataType: double
		isHidden
		summarizeBy: none
		sourceColumn: REFUND_PCT

	partition 'Gross Premium' = m
		mode: import
		source =
				let
				    Source = Snowflake.Databases(SnowflakeServer, SnowflakeWarehouse, [Role = "REPORTER"]),
				    Db = Source{[Name = AnalyticsDatabase, Kind = "Database"]}[Data],
				    Schema = Db{[Name = "CORE", Kind = "Schema"]}[Data],
				    Data = Schema{[Name = "FCT_GROSS_PREMIUM", Kind = "Table"]}[Data]
				in
				    Data

	annotation source_table = core.fct_gross_premium
	annotation table_kind = fact
