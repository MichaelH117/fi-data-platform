	column 'Dealer Group ID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: dealer_group_id

	column 'Group Code'
		dataType: string
		sourceColumn: group_code

	column 'Group Name'
		dataType: string
		sourceColumn: group_name

	column 'Tenant Key'
		dataType: int64
		isHidden
		summarizeBy: none
