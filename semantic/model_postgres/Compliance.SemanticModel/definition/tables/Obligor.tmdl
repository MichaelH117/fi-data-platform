table Obligor

	column 'Obligor Key'
		dataType: string
		isHidden
		isKey
		sourceColumn: obligor_key

	column 'Obligor ID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: obligor_id

	column 'Entity Type'
		dataType: string
		sourceColumn: entity_type

	column 'Obligor Kind'
		dataType: string
		sourceColumn: obligor_kind

	column 'Obligor Name'
		dataType: string
		sourceColumn: obligor_name

	column State
		dataType: string
		sourceColumn: state

	column 'Participation Entity ID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: participation_entity_id

	partition Obligor = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PostgresServer, PostgresDatabase),
				    Data = Source{[Schema = "core", Item = "dim_obligor"]}[Data]
				in
				    Data

	annotation source_table = core.dim_obligor
	annotation table_kind = dim
