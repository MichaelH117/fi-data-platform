	partition Cancellation = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PostgresServer, PostgresDatabase),
				    Data = Source{[Schema = "core", Item = "fct_cancellation"]}[Data]
				in
				    Data

	annotation source_table = core.fct_cancellation
	annotation table_kind = fact
