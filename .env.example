# Copy to .env (git-ignored) and fill in. Only the opt-in Postgres publish step reads these:
#   tools/pg.ps1 start|stop|status|psql      python -m warehouse.postgres sync|reconcile|status
# The default pipeline (python -m pipeline.run) needs none of them.
PG_BIN=C:/path/to/pgsql/bin
PG_DATA=C:/path/to/pgdata
PG_LOG=C:/path/to/pgdata/server.log
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=vsc_analytics
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=<generate-a-random-password>
PG_BI_READER_USER=bi_reader
PG_BI_READER_PASSWORD=<generate-a-random-password>
# Opt-in legacy databases (python -m legacy build|demo|playbook; docs/V3_DESIGN.md 8.1). Defaults shown.
PG_LEGACY_DATABASE=vsc_legacy
PG_LEGACY_ADMIN_DATABASE=vsc_legacy_admin
