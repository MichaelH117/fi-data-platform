table 'Account Holder'

	column 'Account Holder Key'
		dataType: string
		isHidden
		isKey
		sourceColumn: account_holder_key

	column 'Account Holder ID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: account_holder_id

	column 'Holder Type'
		dataType: string
		sourceColumn: holder_type

	column 'Holder Name'
		dataType: string
		sourceColumn: holder_name

	column State
		dataType: string
		sourceColumn: state

	column 'Ref ID'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: ref_id

	column 'Tenant Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: tenant_key

	partition 'Account Holder' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PostgresServer, PostgresDatabase),
				    Data = Source{[Schema = "core", Item = "dim_account_holder"]}[Data]
				in
				    Data

	annotation source_table = core.dim_account_holder
	annotation table_kind = dim
