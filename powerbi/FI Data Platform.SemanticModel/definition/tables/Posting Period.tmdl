/// Accounting calendar. The only table the calculation group filters.
table 'Posting Period'

	column 'Posting Period Key'
		dataType: int64
		isHidden
		summarizeBy: none
		isKey
		sourceColumn: posting_period_key

	column 'Period Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		sourceColumn: period_start

	column 'Period End'
		dataType: dateTime
		formatString: yyyy-mm-dd
		sourceColumn: period_end

	column 'Close Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		sourceColumn: close_date

	column 'Is Closed'
		dataType: boolean
		sourceColumn: is_closed

	column 'Fiscal Year'
		dataType: int64
		summarizeBy: none
		sourceColumn: fiscal_year

	column 'Fiscal Quarter'
		dataType: int64
		summarizeBy: none
		sourceColumn: fiscal_quarter

	column 'Fiscal Month'
		dataType: int64
		summarizeBy: none
		sourceColumn: fiscal_month

	column 'Period Label'
		dataType: string
		sourceColumn: period_label

	hierarchy 'Fiscal Calendar'

		level 'Fiscal Year'
			column: 'Fiscal Year'

		level 'Fiscal Quarter'
			column: 'Fiscal Quarter'

		level 'Period Label'
			column: 'Period Label'

	partition 'Posting Period' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(PostgresServer, PostgresDatabase),
				    Data = Source{[Schema = "core", Item = "dim_posting_period"]}[Data]
				in
				    Data

	annotation source_table = core.dim_posting_period
	annotation table_kind = dim
