/// Every measure is generated from dbt/models/metrics.yml (annotation dbt_metric).
table 'Key Measures'

	/// Reserve premium booked in the sale month.
	measure 'Written Premium' = SUM('Contract Month'[Written Premium])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Premium
		annotation dbt_metric = written_premium
		annotation metric_owner = Data Scientist
		annotation certified = false

	/// Pro-rata earned reserve premium.
	measure 'Earned Premium' = SUM('Contract Month'[Earned Premium])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Premium
		annotation dbt_metric = earned_premium
		annotation metric_owner = Data Scientist
		annotation certified = false

	/// Paid + case reserve on open claims, by loss month.
	measure 'Incurred Claims (accident month)' = SUM('Contract Month'[Incurred Claims])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		annotation dbt_metric = incurred_claims
		annotation metric_owner = Data Scientist
		annotation certified = false

	/// Incurred claims divided by EARNED premium (never written). Not comparable with the loss ratio on claims reserve.
	measure 'Loss Ratio (on earned premium)' = DIVIDE([Incurred Claims (accident month)], [Earned Premium])
		formatString: 0.0%
		displayFolder: Ratios
		annotation dbt_metric = loss_ratio
		annotation metric_owner = Data Scientist
		annotation certified = true

	/// Non-denied claims per earned contract-year, accident-month basis (claims page tile).
	measure 'Claim Frequency' = DIVIDE([Claim Count (accident month)], [Exposure Years])
		formatString: #,0.00
		displayFolder: Ratios
		annotation dbt_metric = claim_frequency
		annotation metric_owner = Data Scientist
		annotation certified = true

	/// Non-denied claims, by loss month.
	measure 'Claim Count (accident month)' = SUM('Contract Month'[Claim Count])
		formatString: #,0
		displayFolder: Claims
		annotation dbt_metric = claim_count_metric
		annotation metric_owner = Data Scientist
		annotation certified = false

	/// Earned contract-years (days in force / 365.25).
	measure 'Exposure Years' = SUM('Contract Month'[Exposure Years])
		formatString: #,0.00
		displayFolder: Exposure
		annotation dbt_metric = exposure_years_metric
		annotation metric_owner = Data Scientist
		annotation certified = false

	/// Contracts sold in the posting period (sales only; amendments add 0), from core.fct_gross_premium.
	measure 'Contracts Written' = SUM('Gross Premium'[Contracts Written])
		formatString: #,0
		displayFolder: Sales
		annotation dbt_metric = contracts_written
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Coverage cost (dealer cost) written in the posting period. The executive overview shows it as Written coverage cost.
	measure 'Gross Coverage Cost' = SUM('Gross Premium'[Coverage Cost])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		annotation dbt_metric = gross_coverage_cost
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Gross consideration on the retail basis.
	measure 'Gross Retail Price' = SUM('Gross Premium'[Retail Price])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		annotation dbt_metric = gross_retail_price
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Gross purchase price
	measure 'Gross Purchase Price' = SUM('Gross Premium'[Purchase Price])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		annotation dbt_metric = gross_purchase_price
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Average coverage cost per contract written
	measure 'Average Coverage Cost' = DIVIDE([Gross Coverage Cost], [Contracts Written])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		annotation dbt_metric = avg_coverage_cost
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Retail price minus coverage cost on business written in the posting period.
	measure 'Dealer Markup Written' = [Gross Retail Price] - [Gross Coverage Cost]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		annotation dbt_metric = dealer_markup_written
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Contracts in force at month end (a balance: it never sums across months).
	measure 'Contracts In Force' =
			VAR _cap = MAX('Reporting Date'[Last Closed Period Key])
			VAR _period = CALCULATE(MAX('Contract Month'[Posting Period Key]), 'Contract Month'[Posting Period Key] <= _cap)
			RETURN
			    CALCULATE(CALCULATE(COUNTROWS('Contract Month'), 'Contract Month'[Is In Force Eom] = TRUE()), 'Posting Period'[Posting Period Key] = _period)
		formatString: #,0
		displayFolder: Portfolio
		annotation dbt_metric = contracts_in_force
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Unearned reserve premium at month end (a balance, so it never sums across months).
	measure 'Unearned Premium Balance' =
			VAR _cap = MAX('Reporting Date'[Last Closed Period Key])
			VAR _period = CALCULATE(MAX('Contract Month'[Posting Period Key]), 'Contract Month'[Posting Period Key] <= _cap)
			RETURN
			    CALCULATE(SUM('Contract Month'[Unearned Premium Eom]), 'Posting Period'[Posting Period Key] = _period)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Premium
		annotation dbt_metric = unearned_premium_balance
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Cancellations
	measure Cancellations = COUNTROWS('Cancellation')
		formatString: #,0
		displayFolder: Cancellations
		annotation dbt_metric = cancellations
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Cancels not later reinstated.
	measure 'Effective Cancellations' = CALCULATE(COUNTROWS('Cancellation'), 'Cancellation'[Is Effective Cancel] = TRUE())
		formatString: #,0
		displayFolder: Cancellations
		annotation dbt_metric = effective_cancellations
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Customer refunds
	measure 'Customer Refunds' = SUM('Cancellation'[Customer Refund])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Cancellations
		annotation dbt_metric = customer_refunds
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Cancel fees
	measure 'Cancel Fees' = SUM('Cancellation'[Cancel Fee])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Cancellations
		annotation dbt_metric = cancel_fees
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Dealer portion of the refund (chargeback).
	measure 'Dealer Chargebacks' = SUM('Cancellation'[Dealer Portion])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Cancellations
		annotation dbt_metric = dealer_chargebacks
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Coverage cost refunds
	measure 'Coverage Cost Refunds' = SUM('Cancellation'[Coverage Cost Refund])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Cancellations
		annotation dbt_metric = coverage_cost_refunds
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Effective cancel rate (effective cancels / contracts written, same period)
	measure 'Effective Cancel Rate' = DIVIDE([Effective Cancellations], [Contracts Written])
		formatString: 0.0%
		displayFolder: Cancellations
		annotation dbt_metric = effective_cancel_rate
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Net coverage cost (gross - coverage cost refunds)
	measure 'Net Coverage Cost' = [Gross Coverage Cost] - [Coverage Cost Refunds]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		annotation dbt_metric = net_coverage_cost
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Reinstatements
	measure Reinstatements = COUNTROWS('Reinstatement')
		formatString: #,0
		displayFolder: Cancellations
		annotation dbt_metric = reinstatements
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Reinstatement reversals
	measure 'Reinstatement Reversals' = SUM('Reinstatement'[Reversal Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Cancellations
		annotation dbt_metric = reinstatement_reversals
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Claim dollars paid (always positive after conforming).
	measure 'Claims Paid' = SUM('Claim Payment Line'[Paid Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		annotation dbt_metric = claims_paid
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Paid plus change in case reserve (as posted).
	measure 'Claims Incurred' = SUM('Claim Payment Line'[Incurred Change])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		annotation dbt_metric = claims_incurred
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Change in outstanding case reserve.
	measure 'Claims Reserve Change' = SUM('Claim Payment Line'[Pending Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		annotation dbt_metric = claims_reserve_change
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Claims with posted activity
	measure 'Claims With Activity' = DISTINCTCOUNT('Claim Payment Line'[Claim Key])
		formatString: #,0
		displayFolder: Claims
		annotation dbt_metric = claims_with_activity
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Average claim process days
	measure 'Average Claim Process Days' = AVERAGE('Claim Payment Line'[Process Days])
		formatString: #,0.00
		displayFolder: Claims
		annotation dbt_metric = avg_claim_process_days
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Claims reported (both systems).
	measure 'Claims Opened' = CALCULATE(COUNTROWS('Claim Summary'), USERELATIONSHIP('Claim Summary'[Reported Month], 'Posting Period'[Period Start]))
		formatString: #,0
		displayFolder: Claims
		annotation dbt_metric = claims_opened
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Claims reported, one row per claim from both admin systems, by loss month.
	measure 'Claims Reported (loss month)' = COUNTROWS('Claim Summary')
		formatString: #,0
		displayFolder: Claims
		annotation dbt_metric = claims_reported_loss_month
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Claims denied (loss month)
	measure 'Claims Denied' = CALCULATE(COUNTROWS('Claim Summary'), 'Claim Summary'[Status Group] = "denied")
		formatString: #,0
		displayFolder: Claims
		annotation dbt_metric = claims_denied
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Paid claims (loss month)
	measure 'Paid Claim Count' = CALCULATE(COUNTROWS('Claim Summary'), 'Claim Summary'[Status Group] = "paid")
		formatString: #,0
		displayFolder: Claims
		annotation dbt_metric = claims_closed_paid
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Claim dollars paid on paid claims (loss month)
	measure 'Paid On Paid Claims' = CALCULATE(SUM('Claim Summary'[Paid Amount]), 'Claim Summary'[Status Group] = "paid")
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		annotation dbt_metric = paid_on_paid_claims
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Claims open as of the as-of date.
	measure 'Open Claims' = CALCULATE(COUNTROWS('Claim Summary'), 'Claim Summary'[Status Group] = "open")
		formatString: #,0
		displayFolder: Claims
		annotation dbt_metric = open_claims
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Open claims reported more than 30 days before the as-of date (seed open_aging_threshold_days).
	measure 'Open Claims Aged 30 Plus' = CALCULATE(COUNTROWS('Claim Summary'), 'Claim Summary'[Is Aged Open] = TRUE())
		formatString: #,0
		displayFolder: Claims
		annotation dbt_metric = open_claims_aged_30_plus
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Average days from reported to closed, closed claims only.
	measure 'Average Turnaround Days' = AVERAGE('Claim Summary'[Turnaround Days])
		formatString: #,0.00
		displayFolder: Claims
		annotation dbt_metric = avg_claim_turnaround_days
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Collected deductibles (admin core status history)
	measure 'Collected Deductibles' = SUM('Claim History'[Collected Deductible])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Claims
		annotation dbt_metric = collected_deductibles
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Same definition as the claims KPI page and mart_claims_kpi.denial_rate.
	measure 'Denial Rate' = DIVIDE([Claims Denied], [Claims Reported (loss month)])
		formatString: 0.0%
		displayFolder: Ratios
		annotation dbt_metric = denial_rate
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Numerator and denominator are the same population (paid claims). Same as mart_claims_kpi.claim_severity.
	measure 'Paid Claim Severity' = DIVIDE([Paid On Paid Claims], [Paid Claim Count])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Ratios
		annotation dbt_metric = paid_claim_severity
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Ledger view, claims incurred as posted / earned claims reserve. Not comparable with the loss ratio on earned premium (the accident-month actuarial view).
	measure 'Loss Ratio (on claims reserve)' = DIVIDE([Claims Incurred], [Earned Reserve])
		formatString: 0.0%
		displayFolder: Ratios
		annotation dbt_metric = posted_loss_ratio
		annotation metric_owner = Financial Analyst II
		annotation certified = true

	/// Remitted cash
	measure 'Remitted Cash' = SUM('Cash Transaction'[Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Remittance
		annotation dbt_metric = remitted_cash
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Remittances
	measure Remittances = COUNTROWS('Cash Transaction')
		formatString: #,0
		displayFolder: Remittance
		annotation dbt_metric = remittances
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Late remittances
	measure 'Late Remittances' = CALCULATE(COUNTROWS('Cash Transaction'), 'Cash Transaction'[Is Late] = TRUE())
		formatString: #,0
		displayFolder: Remittance
		annotation dbt_metric = late_remittances
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Late fees
	measure 'Late Fees' = SUM('Cash Transaction'[Late Fee])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Remittance
		annotation dbt_metric = late_fees
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Average remit age (days)
	measure 'Average Remit Age Days' = AVERAGE('Cash Transaction'[Remit Age Days])
		formatString: #,0.00
		displayFolder: Remittance
		annotation dbt_metric = avg_remit_age_days
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Late remittance rate (late / all remittances)
	measure 'Late Remittance Rate' = DIVIDE([Late Remittances], [Remittances])
		formatString: 0.0%
		displayFolder: Remittance
		annotation dbt_metric = late_remittance_rate
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Disbursed amount
	measure 'Disbursed Amount' = SUM('Disbursement'[Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Disbursements
		annotation dbt_metric = disbursed_amount
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Claims reserve disbursed
	measure 'Disbursed Claims Reserve' = SUM('Disbursement'[Reserve Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Disbursements
		annotation dbt_metric = disbursed_claims_reserve
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Profit-share reserve disbursed
	measure 'Disbursed Profit Share Reserve' = SUM('Disbursement'[Profit Share Reserve])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Disbursements
		annotation dbt_metric = disbursed_profit_share_reserve
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// All earned cost-split buckets in the posting period. The executive overview and the P&L call it Earned premium; it is the combined-ratio denominator.
	measure 'Earned Disbursement Amount' = SUM('Earned Disbursement'[Earned Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Disbursements
		annotation dbt_metric = earned_disbursement_amount
		annotation metric_owner = Financial Analyst II
		annotation certified = true

	/// Earned claims reserve in the posting period, the denominator of the posted loss ratio.
	measure 'Earned Reserve' = SUM('Earned Disbursement'[Earned Reserve])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Disbursements
		annotation dbt_metric = earned_reserve
		annotation metric_owner = Financial Analyst II
		annotation certified = true

	/// Earned admin fee
	measure 'Earned Admin Fee' = CALCULATE(SUM('Earned Disbursement'[Earned Amount]), 'Earned Disbursement'[Disbursement Type] = "ADMIN_FEE")
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Disbursements
		annotation dbt_metric = earned_admin_fee
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Earned acquisition cost (commission + insurer fee + premium tax)
	measure 'Earned Acquisition Cost' = CALCULATE(SUM('Earned Disbursement'[Earned Amount]), 'Earned Disbursement'[Disbursement Type] IN {"COMMISSION", "INSURER_FEE", "PREMIUM_TAX"})
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Disbursements
		annotation dbt_metric = earned_acquisition_cost
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Same as finance.mart_pnl_by_product.combined_ratio and the executive overview. Above 100% the book lost money.
	measure 'Combined Ratio' = DIVIDE(([Claims Incurred] + [Earned Acquisition Cost] + [Earned Admin Fee]), [Earned Disbursement Amount])
		formatString: 0.0%
		displayFolder: Ratios
		annotation dbt_metric = combined_ratio
		annotation metric_owner = Financial Analyst II
		annotation certified = true

	/// Claims reported (dealer scorecard)
	measure 'Scorecard Claims Reported' = SUM('Dealer Scorecard'[Claims Reported])
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_claims_reported
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Claims within the headline early-claim window (seed early_claim_headline_days).
	measure 'Early Claims' = SUM('Dealer Scorecard'[Early Claims])
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = early_claims
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Early claims / claims reported, headline early-claim window (seed early_claim_headline_days).
	measure 'Early Claim Rate' = DIVIDE([Early Claims], [Scorecard Claims Reported])
		formatString: 0.0%
		displayFolder: Dealer Scorecard
		annotation dbt_metric = early_claim_rate
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Dealers on any scorecard watch (loss ratio, late remittance or early claims) at month end.
	measure 'Dealers On Watch' =
			VAR _cap = MAX('Reporting Date'[Last Closed Period Key])
			VAR _period = CALCULATE(MAX('Dealer Scorecard'[Month Key]), 'Dealer Scorecard'[Month Key] <= _cap)
			RETURN
			    CALCULATE(CALCULATE(COUNTROWS('Dealer Scorecard'), 'Dealer Scorecard'[Is Watch] = TRUE()), 'Posting Period'[Posting Period Key] = _period)
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = dealers_on_watch
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Dealers whose T12 loss ratio (on earned claims reserve) is above the scorecard watch threshold, with at least the seed minimum T12 earned claims reserve. The executive overview tile and the dealer scorecard use this one rule.
	measure 'Dealers on Loss-Ratio Watch' =
			VAR _cap = MAX('Reporting Date'[Last Closed Period Key])
			VAR _period = CALCULATE(MAX('Dealer Scorecard'[Month Key]), 'Dealer Scorecard'[Month Key] <= _cap)
			RETURN
			    CALCULATE(CALCULATE(COUNTROWS('Dealer Scorecard'), 'Dealer Scorecard'[Is Watch Loss Ratio] = TRUE()), 'Posting Period'[Posting Period Key] = _period)
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = dealers_on_loss_ratio_watch
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = true

	/// Contracts written in the month (entered-month cohort).
	measure 'Scorecard Contracts Written' = SUM('Dealer Scorecard'[Contracts Written])
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_contracts_written
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Of the contracts written in the month, those since cancelled (sale cohort).
	measure 'Scorecard Contracts Cancelled' = SUM('Dealer Scorecard'[Contracts Cancelled])
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_contracts_cancelled
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Earned claims reserve by earned month (the scorecard loss-ratio denominator).
	measure 'Scorecard Earned Claims Reserve' = SUM('Dealer Scorecard'[Earned Claims Reserve])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_earned_claims_reserve
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Incurred claims by loss month.
	measure 'Scorecard Incurred Claims' = SUM('Dealer Scorecard'[Incurred Claims])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_incurred_claims
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Remittances (dealer scorecard)
	measure 'Scorecard Remittances' = SUM('Dealer Scorecard'[Remittances])
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_remittances
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Late remittances (dealer scorecard)
	measure 'Scorecard Late Remittances' = SUM('Dealer Scorecard'[Late Remittances])
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_late_remittances
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Days past the late threshold, summed over late remittances.
	measure 'Scorecard Days Late Total' = SUM('Dealer Scorecard'[Days Late Total])
		formatString: #,0
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_days_late_total
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Incurred claims (loss month) / earned claims reserve (earned month). With the T12M calculation item this is the watch rule's T12 loss ratio, per dealer or rolled up.
	measure 'Scorecard Loss Ratio (on claims reserve)' = DIVIDE([Scorecard Incurred Claims], [Scorecard Earned Claims Reserve])
		formatString: 0.0%
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_loss_ratio
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Of the contracts written in the months in context, the share since cancelled (sale-cohort basis, as metric cancel_rate).
	measure 'Scorecard Cancel Rate' = DIVIDE([Scorecard Contracts Cancelled], [Scorecard Contracts Written])
		formatString: 0.0%
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_cancel_rate
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Late remittance rate (dealer scorecard)
	measure 'Scorecard Late Remit Rate' = DIVIDE([Scorecard Late Remittances], [Scorecard Remittances])
		formatString: 0.0%
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_late_remit_rate
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Average days late (dealer scorecard, late remittances only)
	measure 'Scorecard Average Days Late' = DIVIDE([Scorecard Days Late Total], [Scorecard Late Remittances])
		formatString: #,0.00
		displayFolder: Dealer Scorecard
		annotation dbt_metric = scorecard_avg_days_late
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// The dealer's rank among peers on the trailing-12 loss ratio at the last closed month. A rank, so it shows for one dealer only (blank on totals).
	measure 'Loss-Ratio Peer Percentile' =
			IF(HASONEVALUE('Dealer Scorecard'[Dealer Key]),
			    VAR _cap = MAX('Reporting Date'[Last Closed Period Key])
			    VAR _period = CALCULATE(MAX('Dealer Scorecard'[Month Key]), 'Dealer Scorecard'[Month Key] <= _cap)
			    RETURN
			        CALCULATE(MAX('Dealer Scorecard'[T12 Loss Ratio Peer Pct]), 'Posting Period'[Posting Period Key] = _period))
		formatString: 0.0%
		displayFolder: Dealer Scorecard
		annotation dbt_metric = loss_ratio_peer_percentile
		annotation metric_owner = Senior Data Analyst (dealer & claims)
		annotation certified = false

	/// Funded-reserve filing: required reserve on the state's default basis.
	measure 'Calculated Reserve' = IF(HASONEVALUE('Funded Reserve Filing'[Scope]), CALCULATE(SUM('Funded Reserve Filing'[Calculated Reserve]), 'Funded Reserve Filing'[Is Default Basis] = TRUE()), CALCULATE(CALCULATE(SUM('Funded Reserve Filing'[Calculated Reserve]), 'Funded Reserve Filing'[Is Default Basis] = TRUE()), 'Funded Reserve Filing'[Scope] = "ITD"))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Filings
		annotation dbt_metric = calculated_reserve
		annotation metric_owner = Senior Data Analyst (regulatory)
		annotation certified = true

	/// Current reserve held (funded-reserve filing)
	measure 'Current Reserve Held' = IF(HASONEVALUE('Funded Reserve Filing'[Scope]), CALCULATE(SUM('Funded Reserve Filing'[Current Reserve]), 'Funded Reserve Filing'[Is Default Basis] = TRUE()), CALCULATE(CALCULATE(SUM('Funded Reserve Filing'[Current Reserve]), 'Funded Reserve Filing'[Is Default Basis] = TRUE()), 'Funded Reserve Filing'[Scope] = "ITD"))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Filings
		annotation dbt_metric = current_reserve
		annotation metric_owner = Senior Data Analyst (regulatory)
		annotation certified = false

	/// Funded-reserve filing: calculated reserve minus current reserve held, when positive.
	measure 'Reserve Shortfall' = IF(HASONEVALUE('Funded Reserve Filing'[Scope]), CALCULATE(SUM('Funded Reserve Filing'[Reserve Shortfall]), 'Funded Reserve Filing'[Is Default Basis] = TRUE()), CALCULATE(CALCULATE(SUM('Funded Reserve Filing'[Reserve Shortfall]), 'Funded Reserve Filing'[Is Default Basis] = TRUE()), 'Funded Reserve Filing'[Scope] = "ITD"))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Filings
		annotation dbt_metric = reserve_shortfall
		annotation metric_owner = Senior Data Analyst (regulatory)
		annotation certified = true

	/// Funded-reserve filing: complaints received (slice Scope and Period Label, never sum across windows).
	measure 'Complaints Received' = IF(HASONEVALUE('Funded Reserve Filing'[Scope]), CALCULATE(SUM('Funded Reserve Filing'[Complaints Received]), 'Funded Reserve Filing'[Is Default Basis] = TRUE()), CALCULATE(CALCULATE(SUM('Funded Reserve Filing'[Complaints Received]), 'Funded Reserve Filing'[Is Default Basis] = TRUE()), 'Funded Reserve Filing'[Scope] = "ITD"))
		formatString: #,0
		displayFolder: Filings
		annotation dbt_metric = complaints_received
		annotation metric_owner = Senior Data Analyst (regulatory)
		annotation certified = true

	/// One filed line. Blank unless one report, line item, scope and basis are in context; across several windows it is blank, except a LAST line (in force), which shows the latest window.
	measure 'Filing Line Value' =
			IF(HASONEVALUE('Regulatory Line Value'[Report ID]) && HASONEVALUE('Regulatory Line Value'[Line Item]) && HASONEVALUE('Regulatory Line Value'[Scope]) && HASONEVALUE('Regulatory Line Value'[Basis]),
			    IF(HASONEVALUE('Regulatory Line Value'[Window ID]), SUM('Regulatory Line Value'[Value]),
			        IF(SELECTEDVALUE('Regulatory Line Value'[Aggregation]) = "LAST",
			            VAR _end = MAX('Regulatory Line Value'[Window End])
			            VAR _w = CALCULATE(MAX('Regulatory Line Value'[Window ID]), 'Regulatory Line Value'[Window End] = _end)
			            RETURN
			                CALCULATE(SUM('Regulatory Line Value'[Value]), 'Regulatory Line Value'[Window ID] = _w))))
		formatString: #,0.00
		displayFolder: Filings
		annotation dbt_metric = filing_line_value
		annotation metric_owner = Senior Data Analyst (regulatory)
		annotation certified = false

	/// Commissions
	measure Commissions = SUM('Commission'[Amount])
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Commissions
		annotation dbt_metric = commissions
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	/// Commission advances
	measure 'Commission Advances' = CALCULATE(SUM('Commission'[Amount]), 'Commission'[Is Advance] = TRUE())
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Commissions
		annotation dbt_metric = commission_advances
		annotation metric_owner = Financial Analyst II
		annotation certified = false

	column Value
		dataType: string
		isHidden
		sourceColumn: [Value]

	partition 'Key Measures' = calculated
		mode: import
		source = ROW("Value", BLANK())
