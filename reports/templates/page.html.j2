<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }} · F&amp;IP · F&amp;I Data Platform</title>
<meta name="description" content="{{ page.lede }}">
<script>document.documentElement.className += " js"; try { var t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}</script>
{% if brand_assets %}<link rel="icon" href="{{ root }}assets/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ root }}assets/favicon.ico" sizes="any">{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600;700&display=swap">
<link rel="stylesheet" href="{{ root }}assets/site.css">
<script src="{{ root }}assets/plotly.min.js"></script>
</head>
{% import "_components.html.j2" as ui with context %}
{% macro cell(c) -%}
  {%- if c is mapping and c.href is defined -%}<a href="{{ root }}{{ c.href }}">{{ c.text }}</a>
  {%- elif c is mapping and c.status is defined and c.status -%}<span class="status status-{{ c.status }}"><span class="status-dot" aria-hidden="true"></span>{{ c.text }}</span>
  {%- elif c is mapping -%}<span class="{{ c.cls | default('') }}">{{ c.text }}</span>
  {%- else -%}{{ c }}{%- endif -%}
{%- endmacro %}
{% macro table(s) -%}
<div class="table-wrap" tabindex="0" role="region" aria-label="{{ s.title }} table">
<table>
  <thead><tr>{% for c in s.cols %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead>
  <tbody>
  {% for row in s.rows %}
    <tr>{% for c in row %}{% if loop.first %}<th scope="row">{{ cell(c) }}</th>{% else %}<td{% if c is string and c and c[:1] not in '0123456789$-' and c != 'n/a' %} class="text"{% elif c is mapping and c.cls is defined and c.cls %} class="{{ c.cls }}"{% endif %}>{{ cell(c) }}</td>{% endif %}{% endfor %}</tr>
  {% endfor %}
  </tbody>
</table>
</div>
{%- endmacro %}
{% macro proof_strip(page) -%}
<section class="proof-strip" aria-labelledby="proof-title">
  <div class="proof-head">
    <h2 id="proof-title" class="proof-strip-title">Results at a glance</h2>
    <p class="proof-strip-sub">Measured, not claimed: each tile is read from the latest pipeline run, its tests and the legacy benchmark.</p>
  </div>
  <div class="kpis proof-tiles">
    {% for k in page.proof %}
    {{ ui.kpi_tile(k) }}
    {% endfor %}
  </div>
  {% if page.proof_note %}<p class="note proof-basis">{{ page.proof_note }}</p>{% endif %}
</section>
{%- endmacro %}
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <button class="nav-toggle" type="button" aria-controls="sidebar" aria-expanded="false"><span class="nav-toggle-bars" aria-hidden="true"></span><span class="nav-toggle-text">Menu</span></button>
  <a class="brand" href="{{ root }}{{ start if nav_top else 'index.html' }}" aria-label="F&amp;IP, F&amp;I Data Platform: home">{{ ui.wordmark() }}<span class="brand-sub">F&amp;I Data Platform</span></a>
  <span class="topbar-meta"><span class="meta-dot" aria-hidden="true"></span>Synthetic data &middot; data as of {{ as_of.strftime('%b %d, %Y') }}</span>
  <button class="theme-toggle" type="button" aria-label="Switch light or dark theme" title="Switch light or dark theme"><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 3a7 7 0 0 1 0 14z" fill="currentColor"/></svg></button>
</header>
<div class="shell">
<aside class="sidebar" id="sidebar">
  <nav aria-label="Reports">
    {% if nav_top %}
    <ul class="nav-list nav-top">
      {% for href, label in nav_top %}
      <li><a href="{{ root }}{{ href }}"{% if href == active %} aria-current="page"{% endif %}><span class="nav-star" aria-hidden="true"></span>{{ label }}</a></li>
      {% endfor %}
    </ul>
    {% endif %}
    {% for group, items in nav_sections %}
    <div class="nav-group">
      <p class="nav-heading" id="nav-g{{ loop.index }}">{{ group }}</p>
      <ul class="nav-list" aria-labelledby="nav-g{{ loop.index }}">
        {% for href, label in items %}
        <li><a href="{{ root }}{{ href }}"{% if href == active %} aria-current="page"{% endif %}>{{ label }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </nav>
</aside>
<div class="content">
<main id="main" tabindex="-1">
  <div class="page-head">
    {% if page.nav %}<p class="crumb"><a href="{{ root }}{{ page.nav }}">&larr; {{ page.crumb or 'All dealers' }}</a></p>{% endif %}
    <h1>{{ page.title }}</h1>
    <p class="lede">{{ ui.t(page.lede) }}</p>
    {% if page.path == 'index.html' and nav_top %}<p class="callout">New here? <a href="{{ root }}{{ start }}">Start here</a>: pick your role and get the three or four pages you need.</p>{% endif %}
  </div>

  {% if page.hero %}<section class="hero" aria-label="Choose your department"><h2 class="hero-title">Who are you?</h2><p class="hero-sub">Pick your department. Each hub opens the questions that team asks and the pages that answer them.</p>{{ chart(page.hero) }}</section>{% endif %}

  {% if page.proof and page.proof_top %}{{ proof_strip(page) }}{% endif %}

  {% if page.kpis %}
  <section class="kpis" aria-label="Key figures">
    {% for k in page.kpis %}
    {{ ui.kpi_tile(k) }}
    {% endfor %}
  </section>
  {% endif %}

  <div class="grid">
  {% for s in page.sections %}
    <section class="card{% if s.wide %} wide{% endif %}" aria-labelledby="s{{ loop.index }}"{% if s.metric_id %} data-metric="{{ s.metric_id }}"{% endif %}>
      <h2 id="s{{ loop.index }}">{{ s.title }}</h2>
      {% if s.caption %}<p class="what">{{ ui.t(s.caption) }}</p>{% endif %}
      {% if s.metric_id and explain is defined %}{{ ui.explain_block(explain(s.metric_id)) }}{% endif %}
      {% if s.html %}<div class="prose">{{ chart(s.html) }}</div>{% endif %}
      {% if s.chart %}
        {{ chart(s.chart) }}
        {% if s.rows %}
        <details class="data-view"><summary>Show the numbers</summary>{{ table(s) }}</details>
        {% endif %}
      {% elif s.rows %}
        {{ table(s) }}
      {% endif %}
      {% if s.note %}<p class="note">{{ s.note }}</p>{% endif %}
    </section>
  {% endfor %}
  </div>
  {% if page.proof and not page.proof_top %}{{ proof_strip(page) }}{% endif %}
</main>
<footer class="foot">
  <p><span class="foot-brand">F&amp;IP</span> Synthetic data for a portfolio project. Data as of {{ as_of.strftime('%b %d, %Y') }}; complete months through {{ last_month }}.
  Metric definitions: docs/METRICS.md. Built by <code>python -m reports</code>.</p>
</footer>
</div>
</div>
<script src="{{ root }}assets/site.js"></script>
</body>
</html>
