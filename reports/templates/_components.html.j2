{# F&IP report components (docs/V3_DESIGN.md 10.1). Imported "with context" so root, gloss and explain resolve. #}

{% macro t(text) -%}{{ gloss(text) if gloss is defined else text }}{%- endmacro %}

{% macro status_badge(status) -%}
{%- if status -%}
<p class="status status-{{ status }}">
  {%- if status == 'good' -%}
  <svg class="status-icon" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6.5l2.6 2.5L10 3.2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
  {%- elif status == 'warning' -%}
  <svg class="status-icon" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8" stroke="currentColor" stroke-width="2.4"/></svg>
  {%- else -%}
  <svg class="status-icon" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1.2L11.2 10.6H.8z" fill="currentColor"/><path d="M6 4.6v3M6 8.6v.9" stroke="#000" stroke-width="1.3"/></svg>
  {%- endif -%}
  <span>{{ {'good': 'On track', 'warning': 'Watch', 'critical': 'Needs action'}[status] }}</span></p>
{%- endif -%}
{%- endmacro %}

{% macro explain_block(e) -%}
{%- if e -%}
{%- if e.placeholder -%}
<p class="explain-pending">Plain-English explanation is being written for this number.</p>
{%- else -%}
<dl class="explain">
  {% for label, text in e.lines() if text %}
  <div><dt>{{ label }}</dt><dd>{{ t(text) }}</dd></div>
  {% endfor %}
</dl>
{%- endif -%}
{%- endif -%}
{%- endmacro %}

{% macro kpi_tile(k) -%}
{% set spark = sparkline(k.spark) if k.spark else '' %}
{% set empty = k.value in ('', 'n/a', None) %}
<div class="kpi{% if spark %} has-spark{% endif %}"{% if k.metric_id %} data-metric="{{ k.metric_id }}"{% endif %}>
  <p class="kpi-label">{{ k.label }}</p>
  {% if empty %}<p class="kpi-value kpi-empty">Not enough data yet</p>{% else %}<p class="kpi-value">{{ k.value }}</p>{% endif %}
  {% if k.status or spark %}<div class="kpi-foot">{{ status_badge(k.status) }}{{ spark }}</div>{% endif %}
  {% if k.sub %}<p class="kpi-sub">{{ t(k.sub) }}</p>{% endif %}
  {% if explain is defined %}{{ explain_block(explain(k.metric_id, k.label)) }}{% endif %}
</div>
{%- endmacro %}

{% macro wordmark(cls='') -%}
<svg class="wordmark {{ cls }}" viewBox="0 0 240 96" aria-hidden="true" focusable="false">
  <defs><clipPath id="wm-slice"><rect x="0" y="50" width="240" height="5"/></clipPath></defs>
  <path d="M0 0H224L240 16V96H0Z" class="wm-block"/>
  <text x="117" y="74" class="wm-glitch" clip-path="url(#wm-slice)">F&amp;IP</text>
  <text x="120" y="74" class="wm-text">F&amp;IP</text>
  <path d="M0 22h240M0 42h240M0 82h240" class="wm-scan"/>
</svg>
{%- endmacro %}
