/// LEGACY ANTI-PATTERN: one semantic model per source schema. Kept for comparison, never deployed.
/// Reinsurance and earnings off the finance cubes. Bound to ONE schema: legacy_finance.
model Model
	culture: en-US
	annotation legacy_schema = legacy_finance
	annotation legacy_anti_pattern = model-per-schema; duplicated dims; conflicting measures
	annotation generated_by = python -m legacy semantic

ref table 'Fact Contracts'
ref table 'Fact Contracts Gen2'
ref table 'Fact Cancels Gen3'
ref table 'Earned Disbursement'
ref table 'Cession Type'
