/// LEGACY ANTI-PATTERN: one semantic model per source schema. Kept for comparison, never deployed.
/// Bound to legacy_reporting.vw_dim_producers.
table Producers
	lineageTag: legacy-reporting-producers

	column ProducerId
		dataType: int64
		sourceColumn: ProducerId
		summarizeBy: none

	column Producer
		dataType: string
		sourceColumn: Producer
		summarizeBy: none

	partition Producers = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(LegacyServer, "vsc_legacy"),
				    Data = Source{[Schema="legacy_reporting", Item="vw_dim_producers"]}[Data]
				in
				    Data
