/// LEGACY ANTI-PATTERN: one semantic model per source schema. Kept for comparison, never deployed.
/// Bound to legacy_reporting.vw_dim_contracts.
table Contracts
	lineageTag: legacy-reporting-contracts

	measure 'Coverage Cost' = SUM(Contracts[CoverageCost])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00

	column ContractId
		dataType: int64
		sourceColumn: ContractId
		summarizeBy: none

	column ContractNumber
		dataType: string
		sourceColumn: ContractNumber
		summarizeBy: none

	column CurrentContractStatus
		dataType: string
		sourceColumn: CurrentContractStatus
		summarizeBy: none

	column EnteredDate
		dataType: dateTime
		sourceColumn: EnteredDate
		summarizeBy: none

	column 'Reportable State'
		dataType: string
		sourceColumn: Reportable State
		summarizeBy: none

	column fxProducerId
		dataType: int64
		sourceColumn: fxProducerId
		summarizeBy: none

	column CoverageCost
		dataType: decimal
		sourceColumn: CoverageCost
		summarizeBy: none

	partition Contracts = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(LegacyServer, "vsc_legacy"),
				    Data = Source{[Schema="legacy_reporting", Item="vw_dim_contracts"]}[Data]
				in
				    Data
